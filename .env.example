# Frontend (opcional)
# Sem estas variáveis, o projeto inicia automaticamente em MODO DEMONSTRAÇÃO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use true para forçar o modo demonstração mesmo com Supabase configurado.
NEXT_PUBLIC_DEMO_MODE=false

# Importação administrativa TSE (somente local/GitHub Actions)
# Nunca exponha a service role no frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_IMPORT_CONCURRENCY=8
